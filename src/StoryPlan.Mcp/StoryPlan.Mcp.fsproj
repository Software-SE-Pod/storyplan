<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>storyplan</AssemblyName>
    <RootNamespace>StoryPlan.Mcp</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>storyplan</ToolCommandName>
    <PackageId>StoryPlan</PackageId>
    <Version>0.1.0</Version>
    <Description>Typed, verifiable pre-PR plans for user stories, served over MCP with an MCP Apps UI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Server.fs" />
    <Compile Include="Web.fs" />
    <Compile Include="Program.fs" />
    <EmbeddedResource Include="ui\plan.html" />
    <EmbeddedResource Include="ui\harness.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoryPlan.Core\StoryPlan.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

</Project>
